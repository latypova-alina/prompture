doctype html
html
  head
    title = content_for(:title) || "Admin — Prompture"
    meta name="viewport" content="width=device-width,initial-scale=1"
    = csrf_meta_tags
    = csp_meta_tag

    css:
      :root {
        --bg: #f6f7f9;
        --surface: #ffffff;
        --border: #e2e5ea;
        --text: #1c2128;
        --text-muted: #6b7280;
        --accent: #3454d1;
        --accent-hover: #2941ab;
        --row-hover: #f0f3fb;

        --status-completed-bg: #e3f8e8;
        --status-completed-text: #1a7f37;
        --status-failed-bg: #fdecea;
        --status-failed-text: #c62828;
        --status-pending-bg: #fff4e0;
        --status-pending-text: #a15c00;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        font-size: 15px;
        line-height: 1.5;
      }

      a { color: var(--accent); text-decoration: none; }
      a:hover { color: var(--accent-hover); text-decoration: underline; }

      header.admin-nav {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 14px 24px;
      }

      header.admin-nav .admin-nav-inner {
        max-width: 1080px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 20px;
      }

      header.admin-nav .brand {
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.01em;
      }

      header.admin-nav nav {
        display: flex;
        gap: 16px;
        font-size: 14px;
      }

      main.admin-container {
        margin: 32px auto;
        padding: 0 104px 48px;
      }

      h1 {
        font-size: 24px;
        margin: 0 0 20px;
        letter-spacing: -0.01em;
      }

      h2 {
        font-size: 18px;
        margin: 32px 0 12px;
      }

      h3 {
        font-size: 15px;
        margin: 0 0 4px;
        display: flex;
        align-items: baseline;
        gap: 8px;
      }

      .back-link { display: inline-block; margin-bottom: 16px; font-size: 14px; }

      .meta-list {
        list-style: none;
        margin: 0 0 24px;
        padding: 16px 20px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 10px 24px;
      }

      .meta-list li { font-size: 14px; }
      .meta-list li strong { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); margin-bottom: 2px; }

      table {
        min-width: 100%;
        border-collapse: collapse;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
      }

      caption { text-align: left; margin-bottom: 8px; }

      thead th {
        text-align: left;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
        background: #fafbfc;
        padding: 10px 14px;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
      }

      tbody td {
        padding: 10px 14px;
        border-bottom: 1px solid var(--border);
        font-variant-numeric: tabular-nums;
        vertical-align: top;
        white-space: nowrap;
      }

      /* Only the Processor cell wraps - it's capped to a fixed width so one
         long value (e.g. a missing translation key) can't blow up the column. */
      .wrap-cell { white-space: normal; overflow-wrap: anywhere; }

      tbody tr:last-child td { border-bottom: none; }
      tbody tr:hover { background: var(--row-hover); }

      .history-links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: 12px;
      }

      .history-links a {
        display: inline-block;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 10px 16px;
        font-weight: 600;
        color: var(--text);
      }

      .history-links a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

      .page-with-filters {
        display: flex;
        align-items: flex-start;
        gap: 72px;
        flex-wrap: wrap;
      }

      .page-content { flex: 1 1 420px; min-width: 0; }

      .table-scroll { overflow-x: auto; }

      .filters-panel { flex: 0 0 260px; width: 260px; }

      .filters-title {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
        margin: 0 0 12px;
      }

      .filters {
        display: flex;
        flex-direction: column;
        gap: 14px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 16px 18px;
      }

      .filters label {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
      }

      .filters select,
      .filters input {
        width: 100%;
        font-size: 14px;
        padding: 6px 8px;
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text);
        background: var(--bg);
      }

      .filters button {
        width: 100%;
        font-size: 14px;
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        background: var(--accent);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
      }

      .filters button:hover { background: var(--accent-hover); }
      .filters-reset { display: block; text-align: center; font-size: 13px; }

      .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
        font-size: 14px;
      }

      .pagination-status { color: var(--text-muted); }
      .pagination-disabled { color: var(--border); }

      .badge {
        display: inline-block;
        padding: 2px 9px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 600;
      }

      .badge-completed { background: var(--status-completed-bg); color: var(--status-completed-text); }
      .badge-failed, .badge-cancelled { background: var(--status-failed-bg); color: var(--status-failed-text); }
      .badge-pending, .badge-processing { background: var(--status-pending-bg); color: var(--status-pending-text); }

      .empty-state { color: var(--text-muted); padding: 24px 0; }
      .muted { color: var(--text-muted); }
      .button-request-list { list-style: none; margin: 0; padding: 0; }
      .button-request-list li + li { margin-top: 4px; }
      .field-value { overflow-wrap: anywhere; }
      .media-grid { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; }
      .media-preview { margin: 0; max-width: 360px; }
      .media-preview figcaption { font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); margin-bottom: 6px; }
      .media-preview img, .media-preview video, .media-preview audio { display: block; max-width: 100%; border-radius: 6px; }
      .media-preview .media-url { display: block; margin-top: 6px; font-size: 12px; overflow-wrap: anywhere; }

  body
    header.admin-nav
      .admin-nav-inner
        span.brand cAIvemanator Admin
        nav
          = link_to "Users", users_path
          = link_to "Requests", requests_path
          = link_to "Command requests", command_requests_path
          = link_to "Button requests", button_requests_path
          = link_to "Blazer", "/blazer"
          = link_to "Sidekiq", "/sidekiq"

    main.admin-container
      = yield
