- if @user
  = link_to "← #{@user.name}", user_path(@user), class: "back-link"

h1 Button requests

.page-with-filters
  .page-content
    - if @result.records.empty?
      p.empty-state No button requests found.
    - else
      .table-scroll
        table
          colgroup
            - if @user.nil?
              col style="width: 160px"
            col style="width: 220px"
            col style="width: 220px"
            col
            col
            col
            col style="width: 60px"
            col style="width: 200px"
            col style="width: 150px"
          thead
            tr
              - if @user.nil?
                th = sortable_header("User", "user", @sort)
              th = sortable_header("Type", "type", @sort)
              th = sortable_header("Processor", "processor", @sort)
              th = sortable_header("Status", "status", @sort)
              th = sortable_header("Cost", "cost", @sort)
              th Media
              th fal
              th = sortable_header("Command", "command", @sort)
              th = sortable_header("Created", "created", @sort)
          tbody
            - @result.records.each do |button_request|
              tr
                - if @user.nil?
                  td.wrap-cell = link_to button_request.user.name, user_path(button_request.user)
                td.wrap-cell = admin_request_link(button_request)
                td.wrap-cell = button_request.humanized_process_name
                td = render "admin/shared/status_badge", status: button_request.status, reason: button_request.failure_reason
                td = button_request.cost
                td
                  - media_url = button_request.try(:resolved_media_url)
                  = link_to "Open", media_url if media_url.present?
                td
                  - fal_url = Admin::FalDashboardUrl.new(button_request).url
                  - if fal_url
                    = link_to "Open", fal_url, target: "_blank", rel: "noopener"
                  - else
                    span.muted —
                td.wrap-cell = admin_request_link_for(button_request.command_request_type, button_request.command_request_id)
                td.wrap-cell = button_request.created_at

    = render "admin/shared/pagination", result: @result

  = render "admin/shared/filters", types: Admin::ButtonRequestTypes::ALL, type_prefix: "Button", command_types: Admin::CommandRequestsQuery::TYPES, statuses: Admin::ButtonRequestTypes::STATUSES, processors: Admin::ButtonRequestTypes.processor_options, user_search: @user.nil?
