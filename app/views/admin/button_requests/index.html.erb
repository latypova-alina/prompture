<%= link_to "← #{@user.name}", user_path(@user), class: "back-link" %>

<h1>Button requests</h1>

<div class="page-with-filters">
  <div class="page-content">
    <% if @result.records.empty? %>
      <p class="empty-state">No button requests found.</p>
    <% else %>
      <div class="table-scroll">
        <table>
          <colgroup>
            <col style="width: 220px">
            <col style="width: 220px">
            <col>
            <col>
            <col>
            <col style="width: 200px">
            <col style="width: 150px">
          </colgroup>
          <thead>
            <tr>
              <th>Type</th>
              <th>Processor</th>
              <th>Status</th>
              <th>Cost</th>
              <th>Media</th>
              <th>Command</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% @result.records.each do |button_request| %>
              <tr>
                <td class="wrap-cell"><%= button_request.class.name %></td>
                <td class="wrap-cell"><%= button_request.humanized_process_name %></td>
                <td>
                  <span class="badge badge-<%= button_request.status.to_s.downcase %>">
                    <%= button_request.status %>
                  </span>
                </td>
                <td><%= button_request.cost %></td>
                <td>
                  <% media_url = button_request.try(:resolved_media_url) %>
                  <%= link_to "Open", media_url if media_url.present? %>
                </td>
                <td class="wrap-cell">
                  <%= button_request.command_request_type %> #<%= button_request.command_request_id %>
                </td>
                <td class="wrap-cell"><%= button_request.created_at %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <%= render "admin/shared/pagination", result: @result %>
  </div>

  <%= render "admin/shared/filters",
             types: Admin::ButtonRequestTypes::ALL,
             type_prefix: "Button",
             command_types: Admin::CommandRequestsQuery::TYPES,
             statuses: Admin::ButtonRequestTypes::STATUSES,
             processors: Admin::ButtonRequestTypes.processor_options %>
</div>
