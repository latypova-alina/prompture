= link_to "← Users", users_path, class: "back-link"

h1 = @user.name
ul.meta-list
  li
    strong ID
    = @user.id
  li
    strong Chat ID
    = @user.chat_id
  li
    strong Locale
    = @user.locale
  li
    strong Balance
    = @user.balance&.credits || 0
  li
    strong Admin
    = @user.admin? ? "yes" : "no"

h2 Generation history
ul.history-links
  li = link_to "Command requests (#{@command_request_count})", user_command_requests_path(@user)
  li = link_to "Button requests (#{@button_request_count})", user_button_requests_path(@user)

h2 Review
- if @user.review
  p.muted = "Submitted #{@user.review.created_at} (survey v#{@user.review.survey_version}, #{@user.review.locale})"
  = render "admin/shared/fields", fields: Reviews::ReadableAnswers.call(@user.review).to_h
- else
  p.empty-state No review yet.
