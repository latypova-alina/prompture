<%= link_to "← Users", users_path, class: "back-link" %>

<h1><%= @user.name %></h1>
<ul class="meta-list">
  <li><strong>Chat ID</strong><%= @user.chat_id %></li>
  <li><strong>Locale</strong><%= @user.locale %></li>
  <li><strong>Balance</strong><%= @user.balance&.credits || 0 %></li>
  <li><strong>Admin</strong><%= @user.admin? ? "yes" : "no" %></li>
</ul>

<h2>Generation history</h2>
<ul class="history-links">
  <li><%= link_to "Command requests (#{@command_request_count})", user_command_requests_path(@user) %></li>
  <li><%= link_to "Button requests (#{@button_request_count})", user_button_requests_path(@user) %></li>
</ul>
