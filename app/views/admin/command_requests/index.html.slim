- if @user
  = link_to "← #{@user.name}", user_path(@user), class: "back-link"

h1 Command requests

.page-with-filters
  .page-content
    - if @result.records.empty?
      p.empty-state No command requests found.
    - else
      .table-scroll
        table
          colgroup
            - if @user.nil?
              col style="width: 160px"
            col style="width: 200px"
            col
            col
            col style="width: 150px"
          thead
            tr
              - if @user.nil?
                th = sortable_header("User", "user", @sort)
              th = sortable_header("Type", "type", @sort)
              th = sortable_header("Category", "category", @sort)
              th Button requests
              th = sortable_header("Created", "created", @sort)
          tbody
            - @result.records.each do |command_request|
              tr
                - if @user.nil?
                  td.wrap-cell = link_to command_request.user.name, user_path(command_request.user)
                td.wrap-cell = admin_request_link(command_request)
                td = command_request.category
                td.wrap-cell
                  - button_requests = @button_requests.fetch([command_request.class.name, command_request.id], [])
                  - if button_requests.empty?
                    span.muted —
                  - else
                    ul.button-request-list
                      - button_requests.each do |button_request|
                        li
                          = admin_request_link(button_request)
                          = " "
                          = render "admin/shared/status_badge", status: button_request.status, reason: button_request.failure_reason
                td.wrap-cell = command_request.created_at

    = render "admin/shared/pagination", result: @result

  = render "admin/shared/filters", types: Admin::CommandRequestsQuery::TYPES, type_prefix: "Command", user_search: @user.nil?, has_button_requests: true
