h1 Requests

.page-with-filters
  .page-content
    - if @result.records.empty?
      p.empty-state No requests found.
    - else
      .table-scroll
        table
          colgroup
            col style="width: 100px"
            col style="width: 220px"
            col style="width: 160px"
            col style="width: 110px"
            col style="width: 150px"
          thead
            tr
              th Kind
              th Type
              th User
              th Status
              th Created
          tbody
            - @result.records.each do |record|
              tr
                td = Admin::CommandRequestsQuery::TYPES.include?(record.class) ? "Command" : "Button"
                td.wrap-cell = "#{record.class.name} ##{record.id}"
                td.wrap-cell = link_to record.user.name, user_path(record.user)
                td
                  - status = record.try(:status)
                  - if status.present?
                    span class="badge badge-#{status.to_s.downcase}"
                      = status
                td.wrap-cell = record.created_at

    = render "admin/shared/pagination", result: @result

  = render "admin/shared/filters", user_search: true
