<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Prompture</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
      :root {
        --tg-bg-color: #ffffff;
        --tg-text-color: #000000;
        --tg-hint-color: #999999;
        --tg-button-color: #2481cc;
        --tg-button-text-color: #ffffff;
        --tg-secondary-bg-color: #f0f0f0;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 16px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: var(--tg-bg-color);
        color: var(--tg-text-color);
      }

      #status {
        display: flex;
        justify-content: center;
        padding: 32px 0;
      }

      .spinner {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 3px solid var(--tg-secondary-bg-color);
        border-top-color: var(--tg-button-color);
        animation: spin 0.8s linear infinite;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      .pack {
        background: var(--tg-secondary-bg-color);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
      }

      .pack-title {
        font-size: 17px;
        font-weight: 600;
        margin-bottom: 4px;
      }

      .pack-estimate {
        color: var(--tg-hint-color);
        font-size: 14px;
        margin-bottom: 12px;
      }

      .pack-buy {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 12px;
        font-size: 15px;
        font-weight: 600;
        background: var(--tg-button-color);
        color: var(--tg-button-text-color);
      }

      .pack-buy:disabled {
        opacity: 0.5;
      }

      .terms {
        margin-bottom: 16px;
      }

      .terms-label {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 14px;
        line-height: 1.4;
        color: var(--tg-text-color);
      }

      .terms-label input {
        flex: none;
        width: 18px;
        height: 18px;
        margin-top: 1px;
      }

      .terms-label a {
        color: var(--tg-button-color);
      }
    </style>
  </head>

  <body>
    <div id="status"><div class="spinner"></div></div>
    <div id="terms" class="terms" style="display: none">
      <label class="terms-label">
        <input type="checkbox" id="terms-checkbox">
        <span><%= t(
          "mini_app.buy_stones.terms_checkbox_html",
          privacy_link: link_to(
            t("mini_app.buy_stones.privacy_link_text"),
            "https://caivemanator.com/privacy_policy",
            class: "policy-link",
            target: "_blank",
            rel: "noopener"
          ),
          terms_link: link_to(
            t("mini_app.buy_stones.terms_link_text"),
            "https://www.caivemanator.com/terms_of_use",
            class: "policy-link",
            target: "_blank",
            rel: "noopener"
          )
        ) %></span>
      </label>
    </div>
    <div id="packs"></div>

    <script>
      (function () {
        var FALLBACK_ERROR = "Something went wrong. Please try again from the bot menu.";

        var tg = window.Telegram && window.Telegram.WebApp;
        var statusEl = document.getElementById("status");
        var packsEl = document.getElementById("packs");
        var termsEl = document.getElementById("terms");
        var termsCheckbox = document.getElementById("terms-checkbox");
        var policyLinks = document.querySelectorAll(".policy-link");

        function applyTheme() {
          if (!tg || !tg.themeParams) return;

          var theme = tg.themeParams;
          var root = document.documentElement;

          if (theme.bg_color) root.style.setProperty("--tg-bg-color", theme.bg_color);
          if (theme.text_color) root.style.setProperty("--tg-text-color", theme.text_color);
          if (theme.hint_color) root.style.setProperty("--tg-hint-color", theme.hint_color);
          if (theme.button_color) root.style.setProperty("--tg-button-color", theme.button_color);
          if (theme.button_text_color) root.style.setProperty("--tg-button-text-color", theme.button_text_color);
          if (theme.secondary_bg_color) root.style.setProperty("--tg-secondary-bg-color", theme.secondary_bg_color);
        }

        function showError(message) {
          statusEl.innerHTML = "";
          statusEl.textContent = message || FALLBACK_ERROR;
          packsEl.innerHTML = "";
        }

        function openInvoice(url, button) {
          if (!tg) return;

          button.disabled = true;

          tg.openInvoice(url, function (status) {
            if (status === "paid") {
              tg.close();
            } else {
              button.disabled = false;
            }
          });
        }

        var hasInvoices = false;

        function setBuyButtonsEnabled(enabled) {
          packsEl.querySelectorAll(".pack-buy").forEach(function (button) {
            button.disabled = !enabled;
          });
        }

        function renderPacks(data) {
          statusEl.style.display = "none";
          termsEl.style.display = "";
          termsCheckbox.disabled = false;
          termsCheckbox.checked = !data.terms_required;
          hasInvoices = !data.terms_required;
          packsEl.innerHTML = "";

          data.packs.forEach(function (pack) {
            var card = document.createElement("div");
            card.className = "pack";

            var title = document.createElement("div");
            title.className = "pack-title";
            title.textContent = pack.title + " — " + pack.stars + " ⭐";

            var estimate = document.createElement("div");
            estimate.className = "pack-estimate";
            estimate.textContent = pack.estimate;

            var buyButton = document.createElement("button");
            buyButton.className = "pack-buy";
            buyButton.textContent = data.buy_button;
            buyButton.disabled = !pack.invoice_url;
            buyButton.addEventListener("click", function () {
              if (!pack.invoice_url) return;
              openInvoice(pack.invoice_url, buyButton);
            });

            card.appendChild(title);
            card.appendChild(estimate);
            card.appendChild(buyButton);
            packsEl.appendChild(card);
          });
        }

        function loadPacks(termsAccepted) {
          fetch(<%= raw mini_app_buy_stones_packs_path.to_json %>, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ init_data: tg ? tg.initData : "", terms_accepted: !!termsAccepted })
          })
            .then(function (response) {
              return response.json().then(function (data) {
                if (!response.ok) throw new Error(data.error || FALLBACK_ERROR);
                return data;
              });
            })
            .then(renderPacks)
            .catch(function (error) {
              termsCheckbox.checked = false;
              termsCheckbox.disabled = false;
              showError(error.message);
            });
        }

        policyLinks.forEach(function (link) {
          link.addEventListener("click", function (event) {
            if (!tg) return;

            event.preventDefault();
            tg.openLink(link.href);
          });
        });

        termsCheckbox.addEventListener("change", function () {
          if (!termsCheckbox.checked) {
            setBuyButtonsEnabled(false);
            return;
          }

          if (hasInvoices) {
            setBuyButtonsEnabled(true);
            return;
          }

          termsCheckbox.disabled = true;
          loadPacks(true);
        });

        if (tg) {
          tg.ready();
          tg.expand();
        }

        applyTheme();
        loadPacks();
      })();
    </script>
  </body>
</html>
